# ====================================================================
# Git 属性配置文件 (.gitattributes)
# ====================================================================

# --------------------------------------------------------------------
# 大文件存储 (Git LFS) 配置
# --------------------------------------------------------------------
# filter=lfs : 指定使用 Git LFS 过滤器来处理该类型文件
# diff=lfs   : 指示 Git 在对比文件差异时使用 LFS 逻辑
# merge=lfs  : 指示 Git 在合并冲突时使用 LFS 逻辑
# -text      : 显式关闭文本处理，将其视为二进制文件，防止 Git 尝试修改其换行符

*.exe filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.msi filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# --------------------------------------------------------------------
# 全局文本文件换行符自动转换配置
# --------------------------------------------------------------------
# text=auto  : 开启 Git 的智能换行符管理
#              - 提交时（上传）：自动将所有文本文件的换行符转换为 Linux 结束符 (LF)
#              - 检出时（下载）：根据用户的操作系统，自动转换为该系统的结束符
#                （Windows 转换为 CRLF，Linux/macOS 转换为 LF）

* text=auto

# 声明为文本，提交和检出根据“为文本文件(text)”设定。
# 大部分文本文件git可以自动识别，只是特殊文件需要当作文本文件处理时手动声明。
# 示例：
# *.js text
# *.py text

# --------------------------------------------------------------------
# 特定文本文件强制锁定配置
# --------------------------------------------------------------------
# eol=lf     : 强制检出时也必须是 LF 结束符（不受用户操作系统影响）

*.sh text eol=lf

